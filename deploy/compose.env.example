# 非敏感 Compose 参数；复制到服务器的 Linx-Night Compose 目录并按需修改。
LINX_IMAGE=ghcr.io/lmh168/linx-night:REPLACE_WITH_COMMIT_SHA
LINX_BUILD_ID=REPLACE_WITH_COMMIT_SHA
LINX_RUNTIME_ENV_FILE=/etc/linx-night/runtime.env
LINX_DATA_DIR=/var/lib/linx-night
LINX_API_HOST_PORT=5000
LINX_CLIENT_HOST_PORT=5010
LINX_MCP_HOST_PORT=9091
