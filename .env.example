# 复制到仓库外，并替换所有 CHANGE_ME；不要提交实际配置。
PORT=5100
CLIENT_PORT=5110
MCP_PORT=9191
# 本机开发保持回环监听；生产 Compose 覆盖为 0.0.0.0。
APP_HOST=127.0.0.1
CLIENT_HOST=127.0.0.1
ADMIN_TOKEN=CHANGE_ME_ADMIN_RANDOM_TOKEN
MCP_AUTH_TOKEN=CHANGE_ME_MCP_RANDOM_TOKEN
LINX_MCP_ADMIN_URL=http://127.0.0.1:9191
LINX_MCP_ADMIN_TOKEN=CHANGE_ME_SAME_AS_ADMIN_TOKEN
LINX_PROFILES=player-a,player-b,player-c,player-d,player-e,player-f,player-g,player-h
LINX_AGENT_ID=CHANGE_ME_PLAYER_AGENT_ID
LINX_SEATS=P2,P3,P4,P5,P6,P7,P8,P9
LINX_HOST_PROFILE=host
LINX_HOST_AGENT_ID=CHANGE_ME_HOST_AGENT_ID
LINX_VOICE_PROFILE=web-voice
# 使用官方音色列表选择九个不同 ID，详见 docs/local-setup.md。
LINX_HOST_VOICE_ID=CHANGE_ME_HOST_VOICE_ID
HOST_PLAYBACK_WATCHDOG_MS=90000
LINX_TURN_TIMEOUT_MS=90000
LINX_ACTION_TIMEOUT_MS=90000
LINX_MCP_DISCOVERY_TIMEOUT_MS=30000
LINX_PLAYER_VOICES={"player-a":"CHANGE_ME_A","player-b":"CHANGE_ME_B","player-c":"CHANGE_ME_C","player-d":"CHANGE_ME_D","player-e":"CHANGE_ME_E","player-f":"CHANGE_ME_F","player-g":"CHANGE_ME_G","player-h":"CHANGE_ME_H"}
# 默认音频目录为 %LOCALAPPDATA%/LinxNight/audio，无需设置路径。
# 可选投票专用短音频；dotenv 不展开 %LOCALAPPDATA% 或 $env，填写实际绝对路径。
# LINX_VOTE_WAV=C:/Users/YOUR_NAME/AppData/Local/LinxNight/audio/vote-turn.wav
